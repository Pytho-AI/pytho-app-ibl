# Edge nginx image — spark + vcorps deployments.
#
# Same slot as `nginx/Dockerfile.cloud` / `nginx/Dockerfile.staging` (one
# Dockerfile per deployment target, colocated with its conf under nginx/).
# The edge target adds a Vite build stage on top of the cloud pattern
# because spark's nginx also serves the analyst SPA locally; cloud
# deployments serve the SPA from pytho-vite (SST / CloudFront) and don't
# need the frontend build.
#
# Build context is repo root (unlike Dockerfile.cloud / Dockerfile.staging
# which scope to ./nginx/) — required because this Dockerfile needs both
# nginx/ (confs + certs) and ui/ (SPA source). Compose invocation:
#
#   build:
#       context: .
#       dockerfile: nginx/Dockerfile.edge

# ---------- Stage 1: build the SPA ----------
FROM node:20-alpine AS build

# Vite build args baked into the JS bundle. VITE_OFFLINE_MODE was
# removed 2026-07-01 — the frontend now always fetches tiles from the
# local tileserver via the nginx /tiles proxy; tile provenance policy
# (which mbtiles are loaded, whether the tileserver proxies external
# services) is a deployment-time backend concern.
ARG VITE_GEO_AGENT_API_URL
ARG VITE_COA_WS_URL
ARG VITE_COA_API_URL
ARG VITE_SHOW_APP_RAIL=false
# Per-deployment master map UUID + default center + zoom + tile server.
# Without these declared as ARG/ENV, docker-compose build-args pass
# through but Vite never sees them. Defaults preserve IDX 26 behavior;
# the V Corps compose override (docker-compose.vcorps.yml) sets them to
# the BPTA / 7th CAA values.
ARG VITE_DEFAULT_MAP_ID
ARG VITE_DEFAULT_CENTER_LON
ARG VITE_DEFAULT_CENTER_LAT
ARG VITE_DEFAULT_ZOOM
ARG VITE_TILESERVER_URL
ENV VITE_GEO_AGENT_API_URL=$VITE_GEO_AGENT_API_URL
ENV VITE_COA_WS_URL=$VITE_COA_WS_URL
ENV VITE_COA_API_URL=$VITE_COA_API_URL
ENV VITE_SHOW_APP_RAIL=$VITE_SHOW_APP_RAIL
ENV VITE_DEFAULT_MAP_ID=$VITE_DEFAULT_MAP_ID
ENV VITE_DEFAULT_CENTER_LON=$VITE_DEFAULT_CENTER_LON
ENV VITE_DEFAULT_CENTER_LAT=$VITE_DEFAULT_CENTER_LAT
ENV VITE_DEFAULT_ZOOM=$VITE_DEFAULT_ZOOM
ENV VITE_TILESERVER_URL=$VITE_TILESERVER_URL

WORKDIR /app
# ui/ is the SPA build context. `.dockerignore` at repo root excludes
# host-platform node_modules to keep the airgap build path clean.
COPY ui/ /app

# Install deps ONLY when the COPY'd node_modules is platform-correct for
# this Alpine build container. rollup (and esbuild, swc, etc.) ship
# per-platform native binaries as OPTIONAL deps — `yarn install` only
# downloads the one matching the install host's platform. If the COPY'd
# node_modules came from a Mac dev's `yarn install`, it has
# @rollup/rollup-darwin-* but NO @rollup/rollup-linux-*-musl, and the
# subsequent `yarn build` dies with "Cannot find module
# @rollup/rollup-linux-arm64-musl" inside this Alpine container.
#
# Skip install ONLY when the platform-matching rollup binary is already
# on disk:
#   - Spark / airgapped target: node_modules vendored from an Alpine
#     build → has @rollup/rollup-linux-arm64-musl → skip install.
#   - Mac / Linux dev with internet: COPY'd node_modules either absent
#     or platform-mismatched → fresh install.
RUN ARCH="$(uname -m)"; \
    case "$ARCH" in \
        aarch64) PLATFORM_ROLLUP="node_modules/@rollup/rollup-linux-arm64-musl" ;; \
        x86_64)  PLATFORM_ROLLUP="node_modules/@rollup/rollup-linux-x64-musl"  ;; \
        *)       PLATFORM_ROLLUP="" ;; \
    esac; \
    if [ -d node_modules ] && [ -n "$(ls -A node_modules 2>/dev/null)" ] && \
       [ -n "$PLATFORM_ROLLUP" ] && [ -d "$PLATFORM_ROLLUP" ]; then \
        echo "node_modules has matching $PLATFORM_ROLLUP — skipping yarn install"; \
    elif [ -d node_modules ] && [ -n "$(ls -A node_modules 2>/dev/null)" ]; then \
        echo "node_modules present but platform-mismatched (need $PLATFORM_ROLLUP) — re-installing"; \
        rm -rf node_modules && yarn install --network-timeout 600000; \
    else \
        echo "node_modules missing — running yarn install"; \
        yarn install --network-timeout 600000; \
    fi
RUN yarn build

# ---------- Stage 2: nginx serving SPA + edge conf + self-signed cert ----------
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
RUN chmod 644 /usr/share/nginx/html/Favicon.png && \
    chown nginx:nginx /usr/share/nginx/html/Favicon.png
RUN chmod 644 /usr/share/nginx/html/support.pdf && \
    chown nginx:nginx /usr/share/nginx/html/support.pdf

# Replace nginx's default configuration with edge conf + main conf.
# nginx-main.conf holds the http-context bits (map for $real_scheme
# etc); nginx.edge.conf is the per-env server block.
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.edge.conf /etc/nginx/conf.d/nginx.conf
COPY nginx/nginx-main.conf /etc/nginx/nginx.conf

# Self-signed TLS cert for the :8443 internal listener that the stream
# multiplexer routes TLS connections to. Pre-generated on a connected
# host (see nginx/ssl/regenerate.sh) and committed to the repo because
# in-image generation used `apk add openssl` which fails on airgap.
# Dev-only cert (self-signed, no chain of trust); regenerate before
# production deploy — but the "production" target for edge is spark's
# SCIF box, where self-signed is expected.
COPY nginx/ssl/cert.pem /etc/nginx/ssl/cert.pem
COPY nginx/ssl/key.pem /etc/nginx/ssl/key.pem
RUN chown -R nginx:nginx /etc/nginx/ssl && \
    chmod 600 /etc/nginx/ssl/key.pem

# Fix permissions so nginx user can write pid + cache dirs.
RUN chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx && \
    chmod -R 755 /var/cache/nginx /var/run /var/log/nginx

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
